#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
export DH_VERBOSE = 1

%:
	dh $@

# systemd units are installed via dh_install and must remain deactivated
# (not enabled or started) on first installation
override_dh_installsystemd:
	true

# Ensure runtime scripts and helpers are executable.
override_dh_fixperms:
	dh_fixperms
	chmod 0755 debian/kvmrun/usr/lib/kvmrun/* debian/kvmrun/usr/share/kvmrun/mk-debian-image

